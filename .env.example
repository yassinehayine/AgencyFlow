# AgencyFlow environment configuration — TEMPLATE
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must
# never be committed (NFR-25). This file documents WHICH variables exist
# without ever carrying a secret.
#
# Every variable below is validated at application boot. A missing or
# malformed value fails startup immediately rather than at the first
# request that happens to need it.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local: the docker-compose single-node replica set. `replicaSet=rs0` is
# required — transactions do not work against a standalone server.
# Production: the MongoDB Atlas M0 mongodb+srv connection string.
MONGODB_URI=mongodb://localhost:27017/agencyflow?replicaSet=rs0

# ---------------------------------------------------------------------------
# Authentication (BR-13, NFR-19)
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. Never reuse across environments.
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars

# ---------------------------------------------------------------------------
# File storage — Cloudinary (ADR-0003)
# ---------------------------------------------------------------------------
# Found in the Cloudinary dashboard as "API Environment variable".
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_FOLDER=agencyflow

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# The web origin allowed to call this API. Local Vite dev server by default;
# in production, the Vercel deployment origin.
CORS_ORIGIN=http://localhost:5173
