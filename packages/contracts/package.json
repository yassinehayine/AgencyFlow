{
  "name": "@agencyflow/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types, enums and constants for the AgencyFlow API and web client",
  "license": "UNLICENSED",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && npm run postbuild",
    "postbuild": "node -e \"require('node:fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'},null,2)); require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'},null,2));\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@agencyflow/config": "0.1.0"
  }
}
